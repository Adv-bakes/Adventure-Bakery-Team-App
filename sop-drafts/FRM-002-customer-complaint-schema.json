{
  "sections": [
    {
      "id": "complaint_receipt",
      "title": "Section 1 — Complaint Receipt",
      "fields": [
        {
          "id": "complaint_ref_no",
          "type": "text",
          "label": "Complaint Ref No.",
          "width": "half",
          "required": true,
          "showInList": true
        },
        {
          "id": "date_received",
          "type": "date",
          "label": "Date Received",
          "width": "half",
          "required": true
        },
        {
          "id": "received_by_csr",
          "type": "text",
          "label": "Received By (CSR)",
          "width": "half",
          "required": true
        },
        {
          "id": "channel",
          "type": "select",
          "label": "Channel",
          "width": "half",
          "options": [
            "Phone",
            "Email",
            "Written correspondence"
          ],
          "multiple": true,
          "required": true
        },
        {
          "id": "date_acknowledged_to_customer_within_24_h",
          "type": "date",
          "label": "Date Acknowledged to Customer (within 24 h)"
        }
      ]
    },
    {
      "id": "customer_product",
      "title": "Section 2 — Customer & Product",
      "fields": [
        {
          "id": "customer_name",
          "type": "text",
          "label": "Customer Name",
          "showInList": true
        },
        {
          "id": "contact_phone_email",
          "type": "text",
          "label": "Contact (phone / email)"
        },
        {
          "id": "product_name",
          "type": "text",
          "label": "Product Name",
          "width": "half",
          "showInList": true
        },
        {
          "id": "lot_batch_code",
          "type": "text",
          "label": "Lot / Batch Code",
          "width": "half"
        },
        {
          "id": "date_best_by_code",
          "type": "text",
          "label": "Date / Best-By Code",
          "width": "third"
        },
        {
          "id": "qty_affected",
          "type": "text",
          "label": "Qty Affected",
          "width": "third"
        },
        {
          "id": "purchase_date",
          "type": "date",
          "label": "Purchase Date",
          "width": "third"
        }
      ]
    },
    {
      "id": "complaint_description",
      "title": "Section 3 — Complaint Description",
      "fields": [
        {
          "id": "customer_description_info",
          "text": "Record the customer's description in their own terms (SQF 2.1.3.1).",
          "type": "info",
          "label": "Customer description instructions"
        },
        {
          "id": "complaint_description_text",
          "type": "textarea",
          "label": "Complaint Description"
        }
      ]
    },
    {
      "id": "classification_samples",
      "title": "Section 4 — Classification & Samples",
      "fields": [
        {
          "id": "classification",
          "type": "select",
          "label": "Classification",
          "options": [
            "Critical (food safety risk)",
            "Non-Critical (quality concern)"
          ],
          "required": true
        },
        {
          "id": "critical_non_critical_info",
          "text": "Critical = contamination, foreign material, allergen presence. Non-Critical = texture, flavor, packaging.",
          "type": "info",
          "label": "Classification explanation"
        },
        {
          "id": "sample_available",
          "type": "checkbox",
          "label": "Sample available?",
          "width": "half"
        },
        {
          "id": "sample_collected",
          "type": "checkbox",
          "label": "Sample collected?",
          "width": "half"
        }
      ]
    },
    {
      "id": "investigation_root_cause",
      "title": "Section 5 — Investigation & Root Cause",
      "fields": [
        {
          "id": "records_reviewed",
          "type": "select",
          "label": "Records reviewed",
          "options": [
            "Production",
            "Packaging",
            "Shipping",
            "Retain samples"
          ],
          "multiple": true
        },
        {
          "id": "investigation_findings",
          "type": "textarea",
          "label": "Investigation findings"
        },
        {
          "id": "root_cause_sqf_2_5_3_1",
          "type": "textarea",
          "label": "Root cause (SQF 2.5.3.1)"
        }
      ]
    },
    {
      "id": "corrective_preventive_action_capa",
      "title": "Section 6 — Corrective & Preventive Action (CAPA)",
      "fields": [
        {
          "id": "capa_instructions",
          "text": "Critical complaints require immediate notification to management and a recall assessment (SQF 2.1.3.3).",
          "type": "info",
          "label": "CAPA instructions"
        },
        {
          "id": "capa_ref",
          "help": "The FRM-007 number, where this complaint opened a corrective action. FSQM-009 Part 3: a critical complaint, or one alleging illness, injury, foreign material or an undeclared allergen, always opens one.",
          "type": "text",
          "label": "CAPA No.",
          "width": "half",
          "showInList": true
        },
        {
          "id": "management_notified_critical",
          "help": "It is a requirement to notify management for any complaint classified as Critical.",
          "type": "select",
          "label": "Management notified (critical)?",
          "width": "half",
          "options": [
            "Yes",
            "N/A"
          ]
        },
        {
          "id": "recall_assessment_required",
          "type": "checkbox",
          "label": "Recall assessment required?",
          "width": "half"
        },
        {
          "id": "corrective_and_preventive_action_taken",
          "type": "textarea",
          "label": "Corrective and preventive action taken"
        },
        {
          "id": "responsible",
          "type": "text",
          "label": "Responsible",
          "width": "third"
        },
        {
          "id": "target_date",
          "type": "date",
          "label": "Target Date",
          "width": "third"
        },
        {
          "id": "completed",
          "type": "date",
          "label": "Completed",
          "width": "third"
        }
      ]
    },
    {
      "id": "communication_closure",
      "title": "Section 7 — Communication & Closure",
      "fields": [
        {
          "id": "communication_instructions",
          "text": "Final findings must be communicated to the customer within 10 business days or sooner (SOP-2.1.3).",
          "type": "info",
          "label": "Communication instructions"
        },
        {
          "id": "communicated_to_customer_on_date",
          "type": "date",
          "label": "Communicated to customer on",
          "width": "third"
        },
        {
          "id": "communicated_by",
          "type": "text",
          "label": "by",
          "width": "third"
        },
        {
          "id": "communicated_via",
          "type": "text",
          "label": "via",
          "width": "third"
        },
        {
          "id": "within_10_business_days",
          "type": "checkbox",
          "label": "Within 10 business days?",
          "width": "half"
        },
        {
          "id": "customer_satisfied",
          "type": "checkbox",
          "label": "Customer satisfied?",
          "width": "half"
        },
        {
          "id": "closed_by_quality_manager",
          "type": "text",
          "label": "Closed by (Quality Manager)",
          "width": "half"
        },
        {
          "id": "closure_date",
          "type": "date",
          "label": "Date",
          "width": "half"
        },
        {
          "id": "signature",
          "role": "verifier",
          "type": "signature",
          "label": "Signature"
        }
      ]
    }
  ],
  "settings": {},
  "schemaVersion": 1
}
