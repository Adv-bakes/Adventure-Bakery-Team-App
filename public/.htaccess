<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA fallback: serve index.html for any path that is not a real file/dir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Apache has no built-in MIME type for .mjs and falls back to text/plain. Browsers refuse to
# execute a module served with a non-JavaScript type, so without this the pdf.js worker fails
# with "Failed to fetch dynamically imported module" even though the file is served 200 OK with
# the correct bytes. Vite emits workers and other ESM chunks as .mjs.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

# Long-cache the fingerprinted assets, never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2?|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
